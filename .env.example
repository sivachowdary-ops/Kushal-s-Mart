# Kushal's Mart - Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local - it is in .gitignore.

# -- Supabase ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -- Razorpay Payments ---------------------------------------------------------
# Get these from Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Get this from Razorpay Dashboard -> Settings -> Webhooks -> Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -- Delhivery Courier ---------------------------------------------------------
# Get this from Delhivery Partner Dashboard -> API Setup
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
# The pickup location name exactly as registered in Delhivery dashboard
DELHIVERY_PICKUP_LOCATION_NAME=kushalsmart
# Set to "staging" or "sandbox" for test; "production" (default) for live
DELHIVERY_ENV=production

# -- Admin Auth (JWT) ----------------------------------------------------------
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_hex_secret_here

# -- Cloudinary Image Storage & CDN --------------------------------------------
# Get these from Cloudinary Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -- Site URL ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kushalsmart.in
